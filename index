<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Pilgrim Bible Baptist Church - Prayer Wall</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #1B365D;
      position: relative;
    }

    /* THE CROP HACK: 
       Pushes the iframe up by 48px to slide the Google banner 
       completely off the screen! */
    iframe {
      position: absolute;
      top: -48px;
      left: 0;
      width: 100%;
      height: calc(100% + 48px);
      border: none;
      display: block;
    }
  </style>
</head>
<body>
  <!-- Notice the link ends in /exec NOT /dev -->
  <iframe 
    src="https://script.google.com/macros/s/AKfycbxRvrHG1EatfpqNMdk1TWe24mfjleDM14nZS3miKFY/exec" 
    allow="clipboard-write">
  </iframe>
</body>
</html>
